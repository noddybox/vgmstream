# This is a documented version of the config file.  Use this as a template to
# configure what works for your environment.  Blank lines and lines starting
# with a hash are ignored.
#
# Settings with an enabled/disabled accept the following:
#
#	yes, on, true, 1	- enable the setting
#	no, off, false, 0	- disable the setting

#
# Icecast 2 settings
#

# The URL to the Icecast 2 mount point.  Optional is misc.outputdir is set.
icecast.url		http://server:port/endpoint

# The password for a source in Icecast 2, that will be the string in the
# <source-password> element in the <authentication> section.  Optional if
# misc.outputdir is set.
icecast.password	your_secret_source_password

# Optional.  Whether to make the stream public.  The default is to not.
icecast.public		off

#
# Playlist settings
#

# The location of the playlist file, with each line being a path to a file
# to stream.
playlist.file		/path/to/filelist

# Optional.  Whether to shuffle the entries in the file or not.  The default is
# to shuffle.
playlist.shuffle	yes

# Optional.  Whether to repeat the playlist or not.  It will be reshuffled if
# playlist.shuffle is enabled when the end is reached.  Default is to repeat.
playlist.repeat		yes

#
# MP3 settings
#

# Optional.  The bitrate to encode MP3 as.  Default is vbr (variable bit rate). 
# Either specifiy "vbr" or the kbps value, e.g. 320.
mp3.bitrate		vbr

#
# Miscellaneous options
#

# Optional.  If this is set don't stream the resulting MP3, but save it to
# this directory.  The MP3 will be called the name of the source file, without
# its extension, and .mp3 added.
misc.outputdir		/path/to/directory
